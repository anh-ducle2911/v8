{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "app.py",
          "hpl_engine.py",
          "engine_ext.py",
          "gemini_ai.py",
          "ai_matcher.py",
          "fuel_price.py",
          "excel_report.py",
          "constraints.json",
          "templates/**",
          "src/**",
          "public/**",
          "data/**"
        ]
      }
    },
    {
      "src": "public/logo-hpl.svg",
      "use": "@vercel/static"
    },
    {
      "src": "src/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/logo-hpl.svg",
      "dest": "/public/logo-hpl.svg"
    },
    {
      "src": "/src/(.*)",
      "dest": "/src/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
